<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#65949D"
    tools:context=".AddBookActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_gravity="center"

        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_centerInParent="true"
            android:background="@drawable/rounded_layout2"
            >
            <ImageView
                android:layout_width="240dp"
                android:layout_height="300dp"
                android:scaleType="fitXY"
                android:onClick="resimSec"
                android:layout_marginTop="25dp"
                android:src="@drawable/resim5"
                android:id="@+id/add_book_activity_imageViewKitapResmi"/>
            <EditText
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:hint="Kitap Adını Giriniz"
                android:layout_marginTop="50dp"
                android:textAlignment="center"
                android:id="@+id/add_book_activity_editTextKitapIsmi"/>
            <EditText
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:hint="Kitap Yazarını Giriniz"
                android:layout_marginTop="15dp"
                android:textAlignment="center"
                android:id="@+id/add_book_activity_editTextKitapYazari"/>
            <EditText
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:hint="Kitap Hakkında ki Yorumunuzu Giriniz"
                android:layout_marginTop="15dp"
                android:textAlignment="center"
                android:id="@+id/add_book_activity_editTextKitapYorum"/>
            <Button
                android:layout_width="230dp"
                android:text="Kaydet"
                android:layout_marginTop="15dp"
                android:textSize="19sp"
                android:onClick="kitapKaydet"
                android:enabled="false"
                android:id="@+id/add_book_activity_btnKaydet"
                android:textColor="#FFFFFF"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_button"
                />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>

